# ============================================================
# MALAK Lab Science Hub — Environment Configuration Template
# Copy this file to server/.env and fill in your values
# NEVER commit the actual .env file to version control
# ============================================================

# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────
# Local MongoDB (default)
MONGODB_URI=mongodb://127.0.0.1:27017/lms_db
# OR MongoDB Atlas
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/lms_prod

# ── Authentication ────────────────────────────────────────
# Set a long, random string (min 32 chars) before starting the server
JWT_SECRET=
JWT_EXPIRE=30d

# Required before running the destructive seed script; use unique strong passwords
SEED_ADMIN_PASSWORD=
SEED_REVIEWER_PASSWORD=
SEED_TECHNICIAN_PASSWORD=
SEED_RECEPTION_PASSWORD=
# Required only when SEED_DEMO_DATA=true
SEED_DEMO_PATIENT_PASSWORD=

# ── CORS ─────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# For custom origins (comma-separated):
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Email (required for OTP and email notifications) ──────
# For Gmail, use an App Password (requires Google 2-Step Verification).
# Keep these values in server/.env; never put SMTP credentials in the client.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-lab-gmail@gmail.com
# SMTP_PASS=your-16-character-google-app-password
# EMAIL_FROM=your-lab-gmail@gmail.com

# ── SMS (Optional — leave blank for log-only mode) ────────
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ── Cloudinary (Optional — for image/document uploads) ───
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ── Payment Gateway (Optional) ───────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# OR
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_razorpay_secret
